{:deps {org.clojure/clojure {:mvn/version "1.12.4"}

        ;; JUnit 5 Platform
        org.junit.jupiter/junit-jupiter-api {:mvn/version "6.0.3"}
        org.junit.jupiter/junit-jupiter-engine {:mvn/version "6.0.3"}
        org.junit.platform/junit-platform-launcher {:mvn/version "6.0.3"}
        org.junit.platform/junit-platform-console {:mvn/version "6.0.3"}

        ;; Serenity BDD
        net.serenity-bdd/serenity-core {:mvn/version "5.2.2"}
        net.serenity-bdd/serenity-junit5 {:mvn/version "5.2.2"}
        net.serenity-bdd/serenity-screenplay {:mvn/version "5.2.2"}
        net.serenity-bdd/serenity-screenplay-webdriver {:mvn/version "5.2.2"}
        net.serenity-bdd/serenity-rest-assured {:mvn/version "5.2.2"}
        net.serenity-bdd/serenity-cli {:mvn/version "5.2.2"}

        ;; Playwright
        com.microsoft.playwright/playwright {:mvn/version "1.58.0"}

        ;; Test runner
        lambdaisland/kaocha {:mvn/version "1.91.1392"}
        lambdaisland/kaocha-junit-xml {:mvn/version "1.17.101"}

        ;; JSON parsing
        org.clojure/data.json {:mvn/version "2.5.2"}}

 :paths ["src" "classes" "resources"]

 :aliases
 {:clean
  {:main-opts ["-e" "(require '[clojure.java.io :as io])(defn delete-recursively [f] (when (.exists (io/file f)) (when (.isDirectory (io/file f)) (doseq [child (.listFiles (io/file f))] (delete-recursively child))) (.delete (io/file f))))(delete-recursively \"target\")(println \"Cleaned target directory\")"]}
  :headed
  {:jvm-opts ["-Dserenity.browser.headless=false"]}
  :test
  {:extra-paths ["test"]}
  :it
  {:extra-paths ["test"]
   :main-opts ["-m" "kaocha.runner"]}

  :aggregate
  {:main-opts ["-e" "(require '[testing.junit :as junit])(junit/generate-reports)(System/exit 0)"]}

  :build
  {:deps {io.github.clojure/tools.build {:git/tag "v0.10.12" :git/sha "97c5562"}}
   :ns-default build}

   :nrepl
   {:extra-deps {nrepl/nrepl {:mvn/version "1.3.1"}
                 cider/cider-nrepl {:mvn/version "0.50.3"}}
    :jvm-opts ["-Dserenity.browser.headless=false"]
    :main-opts ["-m" "testing.repl"]}

   :deploy
   {:extra-deps {slipset/deps-deploy {:mvn/version "0.2.2"}
                 ch.qos.logback/logback-classic {:mvn/version "1.5.18"}
                 ch.qos.logback/logback-core {:mvn/version "1.5.18"}}
    :exec-fn deps-deploy.deps-deploy/deploy
    :exec-args {:installer :remote
                :sign-releases? false}}}}
